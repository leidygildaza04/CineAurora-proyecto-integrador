<mxfile host="app.diagrams.net"><diagram id="polyglot" name="Arquitectura poliglota CineAurora"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="&lt;b&gt;SISTEMA CINEAURORA&lt;/b&gt;&lt;br&gt;Aplicación / Backend&lt;br&gt;&amp;nbsp;&lt;br&gt;Gestión de películas&lt;br&gt;Gestión de funciones&lt;br&gt;Gestión de salas&lt;br&gt;Gestión de ventas&lt;br&gt;Gestión de espectadores&lt;br&gt;&amp;nbsp;&lt;br&gt;Integración PostgreSQL + MongoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="500" height="210" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b style=&quot;font-size:15px&quot;&gt;POSTGRESQL – BASE DE DATOS RELACIONAL&lt;/b&gt;&lt;br&gt;11 tablas relacionales (datos estructurados y transaccionales)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="580" height="900" as="geometry"/></mxCell><mxCell id="mg" value="&lt;b style=&quot;font-size:15px&quot;&gt;MONGODB – BASE DE DATOS DOCUMENTAL&lt;/b&gt;&lt;br&gt;Base de datos: cine_aurora  |  4 colecciones documentales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3f8f3f;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="280" width="580" height="900" as="geometry"/></mxCell><mxCell id="t_ad" value="&lt;b&gt;1. actores_directores&lt;/b&gt;&lt;br&gt;PK: id_actor_director" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="20" y="75" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_tb" value="&lt;b&gt;5. tipos_boleta&lt;/b&gt;&lt;br&gt;PK: id_tipo_boleta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="20" y="210" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_co" value="&lt;b&gt;7. contratos&lt;/b&gt;&lt;br&gt;PK: id_contrato&lt;br&gt;FK: id_actor_director&lt;br&gt;FK: id_pelicula" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="20" y="345" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_ve" value="&lt;b&gt;9. ventas&lt;/b&gt;&lt;br&gt;PK: id_venta&lt;br&gt;FK: id_espectador&lt;br&gt;FK: id_staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="20" y="480" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_dv" value="&lt;b&gt;10. detalle_ventas&lt;/b&gt;&lt;br&gt;PK: id_detalle&lt;br&gt;FK: id_venta&lt;br&gt;FK: id_funcion&lt;br&gt;FK: id_tipo_boleta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="20" y="615" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_fs" value="&lt;b&gt;11. funcion_staff&lt;/b&gt;&lt;br&gt;PK: id_funcion_staff&lt;br&gt;FK: id_funcion&lt;br&gt;FK: id_staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="20" y="750" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_pe" value="&lt;b&gt;2. peliculas&lt;/b&gt;&lt;br&gt;PK: id_pelicula" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="300" y="75" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_es" value="&lt;b&gt;6. espectadores&lt;/b&gt;&lt;br&gt;PK: id_espectador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="300" y="210" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_fu" value="&lt;b&gt;8. funciones&lt;/b&gt;&lt;br&gt;PK: id_funcion&lt;br&gt;FK: id_sala&lt;br&gt;FK: id_pelicula" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="300" y="345" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_sa" value="&lt;b&gt;3. salas&lt;/b&gt;&lt;br&gt;PK: id_sala" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="300" y="480" width="260" height="105" as="geometry"/></mxCell><mxCell id="t_st" value="&lt;b&gt;4. staff&lt;/b&gt;&lt;br&gt;PK: id_staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#336791;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="pg"><mxGeometry x="300" y="615" width="260" height="105" as="geometry"/></mxCell><mxCell id="c_fi" value="&lt;b&gt;1. fichas_tecnicas_peliculas&lt;/b&gt;&lt;br&gt;- id_pelicula&lt;br&gt;- titulo&lt;br&gt;- versiones&lt;br&gt;- elenco&lt;br&gt;- clasificaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="mg"><mxGeometry x="20" y="75" width="540" height="150" as="geometry"/></mxCell><mxCell id="c_re" value="&lt;b&gt;3. resenas_peliculas&lt;/b&gt;&lt;br&gt;- id_pelicula, id_espectador&lt;br&gt;- calificacion, texto, fecha&lt;br&gt;- respuesta_empresa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="mg"><mxGeometry x="20" y="245" width="540" height="150" as="geometry"/></mxCell><mxCell id="c_rq" value="&lt;b&gt;2. requisitos_proyeccion&lt;/b&gt;&lt;br&gt;- id_funcion, id_sala&lt;br&gt;- tipo_proyeccion&lt;br&gt;- requerimientos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="mg"><mxGeometry x="20" y="415" width="540" height="150" as="geometry"/></mxCell><mxCell id="c_in" value="&lt;b&gt;4. reportes_incidentes&lt;/b&gt;&lt;br&gt;- id_sala, id_funcion, id_staff&lt;br&gt;- tipo_incidente, descripcion, fecha&lt;br&gt;- detalles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3f8f3f;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="mg"><mxGeometry x="20" y="585" width="540" height="150" as="geometry"/></mxCell><mxCell id="int" value="&lt;b&gt;INTEGRACIÓN POLÍGLOTA – IDENTIFICADORES COMPARTIDOS&lt;/b&gt;&lt;br&gt;Identificadores compartidos y referencias lógicas&lt;br&gt;&amp;nbsp;&lt;br&gt;fichas_tecnicas_peliculas  →  id_pelicula&lt;br&gt;requisitos_proyeccion  →  id_funcion, id_sala&lt;br&gt;resenas_peliculas  →  id_pelicula, id_espectador&lt;br&gt;reportes_incidentes  →  id_sala, id_funcion, id_staff&lt;br&gt;&amp;nbsp;&lt;br&gt;Los identificadores permiten relacionar los documentos de MongoDB&lt;br&gt;con los registros correspondientes de PostgreSQL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="1270" width="900" height="250" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;LEYENDA&lt;/b&gt;&lt;br&gt;PK = Llave primaria&lt;br&gt;FK = Llave foránea&lt;br&gt;id_* = Identificador compartido&lt;br&gt;PostgreSQL = Información estructurada y transaccional&lt;br&gt;MongoDB = Información documental y flexible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="560" height="150" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;b&gt;TIPOS DE LÍNEA&lt;/b&gt;&lt;br&gt;Línea continua = comunicación del sistema con cada base&lt;br&gt;Línea punteada = referencia lógica (NO es llave foránea),&lt;br&gt;gestionada por la aplicación, no por el motor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1580" width="600" height="150" as="geometry"/></mxCell><mxCell id="e_sp" value="SQL – transacciones ACID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#336791;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#336791;" edge="1" parent="1" source="sys" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_sm" value="Consultas / agregaciones (BASE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#3f8f3f;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#3f8f3f;" edge="1" parent="1" source="sys" target="mg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_pi" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#336791;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#336791;" edge="1" parent="1" source="pg" target="int"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_mi" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#3f8f3f;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#3f8f3f;" edge="1" parent="1" source="mg" target="int"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="id_pelicula" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=oval;startFill=1;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#b85450;" edge="1" parent="1" source="c_fi" target="t_pe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="id_pelicula" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=oval;startFill=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#d79b00;" edge="1" parent="1" source="c_re" target="t_pe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="id_espectador" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=oval;startFill=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#d79b00;" edge="1" parent="1" source="c_re" target="t_es"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="id_funcion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=oval;startFill=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#6c8ebf;" edge="1" parent="1" source="c_rq" target="t_fu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="id_sala" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=oval;startFill=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#6c8ebf;" edge="1" parent="1" source="c_rq" target="t_sa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="id_sala" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=oval;startFill=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#9673a6;" edge="1" parent="1" source="c_in" target="t_sa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="id_funcion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=oval;startFill=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#9673a6;" edge="1" parent="1" source="c_in" target="t_fu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="id_staff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=oval;startFill=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#9673a6;" edge="1" parent="1" source="c_in" target="t_st"><mxGeometry relative="1" as="geometry"/><